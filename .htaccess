# Enable mod_rewrite
RewriteEngine On

# Remove .html extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [L]

# Remove .css extension from URLs (optional, if you want to access CSS without extension)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.css -f
RewriteRule ^([^\.]+)$ $1.css [L]

# Redirect requests with .html extension to extensionless URL (optional)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# Redirect requests with .css extension to extensionless URL (optional)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.css [NC]
RewriteRule ^ %1 [R=301,L]
